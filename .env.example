# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini (Saathi chat + employer analysis AI fallback)
VITE_GEMINI_API_KEY=

# Consolidated API base URL.
# Leave blank to derive `https://us-central1-<projectId>.cloudfunctions.net/api`
# from VITE_FIREBASE_PROJECT_ID. Override for emulator or custom Cloud Run URL,
# e.g. http://localhost:5001/<projectId>/us-central1/api
VITE_API_BASE=
