rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Criteria: employer reads own (any status), others read active only, authenticated create
    match /criteria/{code} {
      allow read: if resource.data.employerId == request.auth.uid
        || resource.data.status == 'active';
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.employerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.employerId == request.auth.uid;
    }

    // Sessions: only the owning candidate
    match /sessions/{sessionId} {
      allow read, update: if request.auth != null
        && resource.data.candidateId == request.auth.uid;
      allow create: if false; // Cloud Functions only
      allow delete: if false;
    }

    // Scorecards: candidates own, employers for their criteria.
    // Demo-tagged docs (written only via the Admin SDK seed script) are
    // publicly readable so the dashboards have a live, dynamic backing
    // dataset even before a user has run a real Bridge test.
    match /scorecards/{scorecardId} {
      allow read: if (request.auth != null
            && (resource.data.candidateId == request.auth.uid
                || resource.data.employerId == request.auth.uid))
        || resource.data.isDemo == true;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // Matches: candidates create, both sides read; isDemo docs publicly readable.
    match /matches/{matchId} {
      allow read: if (request.auth != null
            && (resource.data.candidateId == request.auth.uid
                || resource.data.employerId == request.auth.uid))
        || resource.data.isDemo == true;
      allow create: if false; // Cloud Functions only
      allow update, delete: if false;
    }

    // Replies: employers create, both sides read; isDemo docs publicly readable.
    match /replies/{replyId} {
      allow read: if (request.auth != null
            && (resource.data.candidateId == request.auth.uid
                || resource.data.employerId == request.auth.uid))
        || resource.data.isDemo == true;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // Notifications: only the recipient reads; isDemo docs publicly readable.
    match /notifications/{notifId} {
      allow read: if (request.auth != null
            && resource.data.recipientId == request.auth.uid)
        || resource.data.isDemo == true;
      allow create, update, delete: if false;
    }

    // Devices: only the owner can read/write their own device doc.
    // Creates must include the owning uid so the update gate can verify it.
    // Updates may only touch lastSeen and the (additive) emails array,
    // never reassign ownership.
    match /devices/{deviceId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'deviceId', 'firstSeen', 'lastSeen']);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSeen', 'emails']);
      allow delete: if false;
    }

    // Email-to-device binding. An email can be on multiple anonymous devices
    // (work laptop + phone is legitimate), so ownership-by-uid does not fit.
    // Any authenticated user may add their device to the binding, but the
    // immutable email field cannot be reassigned and no sibling fields can
    // be introduced. setDoc(merge:true) re-sends email, so allow it in
    // affectedKeys but pin its value to the existing record.
    match /emailDevices/{emailHash} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'devices', 'lastSeen']);
      allow update: if request.auth != null
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'devices', 'lastSeen']);
      allow delete: if false;
    }

    // Mail collection for SendGrid trigger
    match /mail/{mailId} {
      allow read, write: if false; // Cloud Functions only
    }

    // Password-protected shareable resumes.
    // - Read is public (anyone with the URL can view).
    // - Create and update go through Cloud Functions (createSharedResume,
    //   updateSharedResume) so the server can verify the password hash.
    // - Direct client writes are blocked so the client cannot bypass the
    //   password check by writing straight to Firestore.
    match /resumes/{slug} {
      allow read: if slug.size() >= 6 && slug.size() <= 32
        && slug.matches('[A-Za-z0-9_-]+');
      allow create, update, delete: if false;
    }
  }
}
